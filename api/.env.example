# TibetRide API — Environment Variables
# Copy this file to your Vercel project's Environment Variables settings.

# ── Supabase ──────────────────────────────────────────────────────────
# From: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...  # service_role key (server-only, never expose)

# ── SMTP ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=torchlight@foxmail.com
SMTP_PASS=your_smtp_password
SMTP_FROM=torchlight@foxmail.com
SMTP_NOTIFY_TO=torchlight@foxmail.com

# ── Feishu (existing, keep) ───────────────────────────────────────────
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_APP_TOKEN=xxxxxxxxxxxxxxxxxxxxx
FEISHU_TABLE_ID=xxxxxxxx
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxxxxxxxxxxxxxxxxxxxx
