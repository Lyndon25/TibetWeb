{
  "version": 2,
  "name": "tibetride-website",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "tibetride.com"
        }
      ],
      "destination": "https://www.tibetride.com/$1",
      "permanent": true
    }
  ],
  "functions": {
    "api/contact.py": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/tours",
      "dest": "/tours/index.html"
    },
    {
      "src": "/videos",
      "dest": "/videos/index.html"
    },
    {
      "src": "/articles",
      "dest": "/articles/index.html"
    },
    {
      "src": "/articles/([^/]+?)(?:\\.html)?(?:/.*)?$",
      "dest": "/articles/$1/index.html"
    },
    {
      "src": "/guides",
      "dest": "/guides/index.html"
    },
    {
      "src": "/about",
      "dest": "/about.html"
    },
    {
      "src": "/contact",
      "dest": "/contact.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
